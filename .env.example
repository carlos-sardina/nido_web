# Public Supabase credentials (safe for the browser).
# Copy this file to .env.local and fill in values from the Supabase
# project API settings. Never put service_role, secret keys, or
# database passwords here.
#
# Email confirmation and password recovery use these redirect URLs.
# Add them in Authentication → URL Configuration:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/update-password
# Production: https://<your-production-domain>/auth/callback
#             https://<your-production-domain>/auth/update-password
#
# See docs/supabase.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
