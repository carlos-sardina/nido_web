# Public Supabase credentials (safe for the browser).
# Copy this file to .env.local and fill in values from the Supabase
# project API settings. Never put service_role, secret keys, or
# database passwords here.
#
# Google OAuth also requires dashboard configuration. See docs/supabase.md.
# Local callback URL: http://localhost:3000/auth/callback
# Production callback URL: https://<your-production-domain>/auth/callback
#
# See docs/supabase.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
